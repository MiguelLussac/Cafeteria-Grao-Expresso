# Copie este arquivo para .env apenas para desenvolvimento local.
FLASK_ENV=development
FLASK_APP=run.py

# Gere dois valores aleatórios diferentes com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# No desenvolvimento, se ficarem vazios, a aplicação gera segredos temporários.
# Em produção, ambos são obrigatórios, aleatórios e com pelo menos 32 caracteres.
SECRET_KEY=
JWT_SECRET_KEY=

# Banco de dados
DATABASE_URL=sqlite:///grao_expresso.db
# Supabase (Postgres): use a string do "Session pooler" (porta 5432), em
# Connect > Session pooler no painel do projeto. A conexão direta usa IPv6,
# que o Render não suporta.
# DATABASE_URL=postgresql://postgres.<ref-do-projeto>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

PORT=5000
