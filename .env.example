# Configurações do Flask
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=sua-chave-secreta-forte-aqui
JWT_SECRET_KEY=sua-chave-jwt-super-secreta-aqui

# Banco de dados
# Para desenvolvimento local padrão (SQLite):
DATABASE_URL=sqlite:///grao_expresso.db

# Para produção no Render com MySQL:
# DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/grao_expresso_db

# Porta do servidor
PORT=5000
